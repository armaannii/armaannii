<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="300" viewBox="0 0 1200 300" role="img" aria-label="Hi, I'm Arman - Full-Stack Developer" xmlns:c2pa="http://c2pa.org/manifest">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="50%" stop-color="#1e1b4b"/>
      <stop offset="100%" stop-color="#0c4a6e"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#a78bfa"/>
    </linearGradient>
    <style>
      .title { font: 700 64px 'Segoe UI', Arial, Helvetica, sans-serif; fill: #ffffff; }
      .sub   { font: 500 26px 'Segoe UI', Arial, Helvetica, sans-serif; fill: url(#accent); }
      .chip  { font: 600 15px 'Segoe UI', Arial, Helvetica, sans-serif; fill: #e2e8f0; }
      .code  { font: 400 18px 'Courier New', monospace; fill: #64748b; }
      .fade  { animation: fade 1.2s ease-out both; }
      .float { animation: float 6s ease-in-out infinite; }
      @keyframes fade  { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
      @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    </style>
  </defs>

  <rect width="1200" height="300" rx="16" fill="url(#bg)"/>

  <!-- decorative circles -->
  <g class="float" opacity="0.35">
    <circle cx="1050" cy="70" r="90" fill="none" stroke="#38bdf8" stroke-width="2"/>
    <circle cx="1100" cy="230" r="55" fill="none" stroke="#a78bfa" stroke-width="2"/>
    <circle cx="930" cy="215" r="20" fill="#38bdf8" opacity="0.5"/>
  </g>

  <!-- code decoration -->
  <text class="code" x="880" y="140">&lt;/&gt;</text>
  <text class="code" x="960" y="165">{ }</text>

  <!-- text -->
  <g class="fade">
    <text class="title" x="70" y="125">Hi, I'm Arman</text>
    <text class="sub" x="70" y="175">Full-Stack Developer  |  React &amp; Next.js Enthusiast</text>
  </g>

  <!-- tech chips -->
  <g class="fade" style="animation-delay:0.4s">
    <rect x="70"  y="215" width="110" height="34" rx="17" fill="#ffffff" fill-opacity="0.1" stroke="#38bdf8" stroke-opacity="0.6"/>
    <text class="chip" x="125" y="237" text-anchor="middle">Next.js</text>

    <rect x="195" y="215" width="100" height="34" rx="17" fill="#ffffff" fill-opacity="0.1" stroke="#38bdf8" stroke-opacity="0.6"/>
    <text class="chip" x="245" y="237" text-anchor="middle">React</text>

    <rect x="310" y="215" width="130" height="34" rx="17" fill="#ffffff" fill-opacity="0.1" stroke="#a78bfa" stroke-opacity="0.6"/>
    <text class="chip" x="375" y="237" text-anchor="middle">TypeScript</text>

    <rect x="455" y="215" width="130" height="34" rx="17" fill="#ffffff" fill-opacity="0.1" stroke="#a78bfa" stroke-opacity="0.6"/>
    <text class="chip" x="520" y="237" text-anchor="middle">Tailwind</text>

    <rect x="600" y="215" width="80" height="34" rx="17" fill="#ffffff" fill-opacity="0.1" stroke="#a78bfa" stroke-opacity="0.6"/>
    <text class="chip" x="640" y="237" text-anchor="middle">C++</text>
  </g>
<metadata><c2pa:manifest></c2pa:manifest></metadata></svg>
